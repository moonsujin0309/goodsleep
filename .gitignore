node_modules/
.DS_Store
Thumbs.db
tools/.venv/

# 직접 받은 음원은 커밋하지 않는다.
# 무료 라이브러리 대부분이 "소스 파일과 함께 재배포"를 금지하므로
# 공개 저장소에 올리면 라이선스 위반이 된다. CC0 로 확인한 것만 아래 예외에 추가할 것.
audio/**/*.mp3
audio/**/*.ogg
audio/**/*.wav
audio/**/*.m4a

# 비교용 샘플은 굳이 배포하지 않는다
audio/_samples/

# 예외: TTS 로 생성한 나레이션은 배포해야 앱이 소리를 낸다.
!audio/narration/**/*.mp3

# API 키. 절대 커밋하지 않는다.
tools/.env

__pycache__/
